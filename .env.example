# ==============================================================================
# Officer-Assistant (Shark) — Production Environment Configuration Template
# Copy this file to .env.local for development or configure in production host (e.g., Vercel)
# ==============================================================================

# Application URL (Used for metadata, OpenGraph, sitemap, Stripe redirects)
NEXT_PUBLIC_APP_URL=https://officerassistant.app

# ------------------------------------------------------------------------------
# Supabase Configuration (Optional for local-only, required for cloud sync)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
CREW_WALL_ENABLED=false

# ------------------------------------------------------------------------------
# Stripe Payments & Subscriptions (USD)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PRICE_MONTHLY=price_your_monthly_price_id
STRIPE_PRICE_YEARLY=price_your_yearly_price_id

# ------------------------------------------------------------------------------
# Google Gemini API (AI Visual IMPA Store Scanner)
# Provide your Gemini / Google AI Studio API key (GEMINI_API_KEY or GOOGLE_API_KEY)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-google-gemini-api-key
# GOOGLE_API_KEY=your-google-gemini-api-key

# ------------------------------------------------------------------------------
# AIS Vessel Tracking Provider
# Mode options: 'free' (Open Waters anonymous), 'mock', 'off', 'paid' (DataDocked)
# ------------------------------------------------------------------------------
VESSEL_PROVIDER_MODE=free
DATADOCKED_API_KEY=
PAID_API_MAX_MONTHLY_REQUESTS=20

# ------------------------------------------------------------------------------
# User Session Security
# ------------------------------------------------------------------------------
USER_SESSION_SECRET=generate-a-strong-64-character-random-hex-string

# ------------------------------------------------------------------------------
# Administrator Security & 2FA Gate
# REQUIRED IN PRODUCTION: Replace with strong credentials.
# ------------------------------------------------------------------------------
ADMIN_SESSION_SECRET=generate-a-strong-64-character-random-hex-string
ADMIN_USERNAME=sharkadmin
ADMIN_PASSWORD=change-this-to-a-very-strong-production-password
ADMIN_MFA_SECRET=BASE32SECRETFORAUTHENTICATORAPP
ADMIN_MFA_BACKUP_CODE=change-to-random-emergency-code
ADMIN_MFA_ENABLED=true
ADMIN_ALLOWED_IPS=*
ADMIN_DIRECT_PATH=/admin
