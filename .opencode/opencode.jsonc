{
  "$schema": "https://opencode.ai/config.json",
  // Branch protection policy: Local agent sessions are restricted from pushing directly to main.
  // Pushes are strictly limited to isolated vibe/* branches.
  "permissions": [
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git fetch *", "effect": "allow" },
    { "action": "shell", "resource": "git pull *", "effect": "allow" },
    { "action": "shell", "resource": "git checkout *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git push *vibe/*", "effect": "allow" },
    { "action": "shell", "resource": "git push *--force*", "effect": "deny" },
    { "action": "shell", "resource": "git push *main*", "effect": "deny" }
  ],
  "agents": {
    "build": {
      "permissions": [
        { "action": "shell", "resource": "git push *", "effect": "deny" },
        { "action": "shell", "resource": "git push *vibe/*", "effect": "allow" },
        { "action": "shell", "resource": "git push *main*", "effect": "deny" },
        { "action": "shell", "resource": "git push *--force*", "effect": "deny" }
      ]
    }
  }
}
